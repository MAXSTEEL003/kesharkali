# ========================================================
# KESHAR KALI OPERATIONS PORTAL — ENVIRONMENT CONFIGURATION
# ========================================================

# --- Core Server Configuration ---
PORT=5000
NODE_ENV=development
DB_PATH=./data/kesharkali.db
JWT_SECRET=keshar_kali_secure_jwt_secret_change_in_production_2026

# --- WhatsApp Cloud API Configuration (Optional) ---
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ========================================================
# FIREBASE CLIENT CONFIGURATION (Vite Frontend: src/firebase/config.js)
# Obtain these values from Firebase Console -> Project Settings -> General -> Your apps -> SDK setup/configuration
# ========================================================
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:your_sender_id:web:your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ========================================================
# FIREBASE ADMIN SDK CONFIGURATION (Server Backend: server/firebase/admin.js)
# Obtain from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
# ========================================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# Note: For private keys with newlines, replace newlines with \n in the .env file
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
# Or provide the path to your service account JSON file:
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

