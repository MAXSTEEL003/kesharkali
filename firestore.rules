rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'Admin' || request.auth.token.admin == true);
    }
    
    function isStaff() {
      return isAuthenticated();
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Master Catalogs (Customers, Warehouses, Products)
    match /customers/{customerId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /warehouses/{warehouseId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /products/{productId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // Confidential Industry Mills (Purchases & Sourcing Rates restricted)
    match /industries/{industryId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // Purchase Orders & Allocations
    match /purchase_orders/{poId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /industry_allocations/{allocId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // Master Loading Register Entries
    match /loading_entries/{loadingId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // Dispatches
    match /dispatches/{dispatchId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // WhatsApp Notification Deliveries
    match /whatsapp_notifications/{notifId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // Stock Ledger Transactions (Append-only audit trail)
    match /stock_ledger/{txnId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false; // Immutable accounting ledger
    }

    // Audit Logs
    match /audit_logs/{logId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if false; // Tamper-proof
    }

    // User Profiles & Settings
    match /users/{userId} {
      allow read: if isStaff();
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }
  }
}

